{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    "dist-electron/**",
    "node_modules/**",
    "build/**",
    "out/**"
  ],
  "overrides": [
    {
      "files": ["electron/**"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ]
}
